// Cloudflare 部署設定（2026-10-22）：Workers static assets（Pages 的新版）出靜態檔，同一個 Worker 跑 API。
// 本機：pnpm build 之後 `npx wrangler deploy`；GitHub：推 main 由 .github/workflows/deploy-cloudflare.yml 自動做同一件事。
// 回應標頭在 public/_headers（build 會帶進 dist）。
// D1 的表用 migrations/ 管（只加不刪）：`npx wrangler d1 migrations apply kitewise --remote`，deploy 不會自動跑。
{
  "name": "kitewise",
  "compatibility_date": "2026-10-22",
  // 正式網域 kitewise.nz（DNS 在同一個 Cloudflare 帳號，custom_domain 會自動建 DNS 紀錄與憑證；2026-10-24）。
  // 第一次 deploy 前要先把 Cloudflare 掃進來的 1st Domains 停泊紀錄（A kitewise.nz、CNAME www）刪掉，不然會說紀錄已存在。
  "workers_dev": true,
  "routes": [
    { "pattern": "kitewise.nz", "custom_domain": true },
    { "pattern": "www.kitewise.nz", "custom_domain": true }
  ],
  // API 在 worker/index.ts（Hono）。只有下面四組路徑會進 Worker，其他路徑直接出靜態檔、不算 Worker 執行次數（2026-10-25 全國版階段 0）
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    // 找不到的路徑回 404，不要回 index.html：App 用 hash 路由，真正的路徑只有 /、/privacy.html、/delete-data.html
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/auth/*", "/ingest/*", "/admin", "/admin/*"],
    // 階段 5：/admin 的 index.html 由 Worker 出（worker/admin.ts 用這個綁定拿）
    "binding": "ASSETS"
  },
  // 全國版資料庫與快照（docs/national-plan.md §2、§2.6）
  "d1_databases": [
    { "binding": "DB", "database_name": "kitewise", "database_id": "bcc9b2ef-a037-41f7-b96d-68f57a2cccea", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "kitewise-data" }
  ],
  // 費用保險：單次請求 CPU 超過 200 ms 就砍（正常請求幾 ms；/ingest 一批 1,000 列和重建一家店 3,000 多列的 R2 快照要幾十 ms，10-25 從 50 放寬）
  "limits": { "cpu_ms": 200 },
  // 公開值（anon key 本來就在前端 bundle 裡），不是機密。機密（INGEST_TOKEN 等）用 `wrangler secret put`。
  "vars": {
    // 階段 5（docs/stage5-contract.md）：後台的 Cloudflare Access。兩個都是公開值；空字串 = 沒開 Access（本機），Worker 退回 kw_session + admins 表
    "ACCESS_TEAM_DOMAIN": "orange-base-53db.cloudflareaccess.com",
    "ACCESS_AUD": "046d6462c3b128b9778621dc9dd470c938ea29248ced8e2f90b1ecd409fbf799",
    // 階段 4（docs/stage4-contract.md）：Google OAuth 用戶端 id 是公開值；DEV_LOGIN 正式一定空字串（.dev.vars 設 1 才開 /auth/dev-login）
    "GOOGLE_CLIENT_ID": "991666308220-asq2eknlnbh7e5f3m84p5809sgbjedel.apps.googleusercontent.com",
    "DEV_LOGIN": "",
    "OPENAI_RECIPE_MODEL": "gpt-5.4-mini",
    "SUPABASE_URL": "https://mzuckacocbeuekdzikzu.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im16dWNrYWNvY2JldWVrZHppa3p1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg1OTM2ODEsImV4cCI6MjEwNDE2OTY4MX0.PsMxNPREbVMpan-qPpmyOcFV4bz7T9J9o7k4ac_j55E"
  },
  "observability": { "enabled": false }
}
