// Cloudflare 部署設定（2026-10-22）：純靜態站，用 Workers 的 static assets（Pages 的新版，wrangler 4 建新專案一律走這條）。
// 本機：pnpm build 之後 `npx wrangler deploy`；GitHub：推 main 由 .github/workflows/deploy-cloudflare.yml 自動做同一件事。
// 回應標頭在 public/_headers（build 會帶進 dist）。
{
  "name": "kitewise",
  "compatibility_date": "2026-10-22",
  // 正式網域 kitewise.nz（DNS 在同一個 Cloudflare 帳號，custom_domain 會自動建 DNS 紀錄與憑證；2026-10-24）。
  // 第一次 deploy 前要先把 Cloudflare 掃進來的 1st Domains 停泊紀錄（A kitewise.nz、CNAME www）刪掉，不然會說紀錄已存在。
  "workers_dev": true,
  "routes": [
    { "pattern": "kitewise.nz", "custom_domain": true },
    { "pattern": "www.kitewise.nz", "custom_domain": true }
  ],
  // /api/* 由 worker/index.js 處理（特價資料的 Supabase 快取代理，2026-10-25），其他路徑直接出靜態檔、不算 Worker 執行次數
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    // 找不到的路徑回 404，不要回 index.html：App 用 hash 路由，真正的路徑只有 /、/privacy.html、/delete-data.html
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  // 公開值（anon key 本來就在前端 bundle 裡），不是機密
  "vars": {
    "SUPABASE_URL": "https://mzuckacocbeuekdzikzu.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im16dWNrYWNvY2JldWVrZHppa3p1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg1OTM2ODEsImV4cCI6MjEwNDE2OTY4MX0.PsMxNPREbVMpan-qPpmyOcFV4bz7T9J9o7k4ac_j55E"
  },
  "observability": { "enabled": false }
}
